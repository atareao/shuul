# ── Shuul Configuration ──

# Secret for JWT signing (generate with: openssl rand -hex 32)
SECRET=change-me-to-a-random-string

# OIDC / PocketID
OIDC_ISSUER_URL=https://auth.tudominio.com
OIDC_CLIENT_ID=shuul
OIDC_CLIENT_SECRET=your-client-secret
OIDC_REDIRECT_URL=https://shuul.tudominio.com/api/v1/auth/callback

# GeoIP (opcional — si no se pone, se desactiva la geolocalización)
# MAXMIND_DB_PATH=/app/data/GeoLite2-City.mmdb
# MAXMIND_LICENSE_KEY=your-license-key

# Log level (opcional, por defecto info)
# RUST_LOG=debug